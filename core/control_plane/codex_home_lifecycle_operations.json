  "global_rules": {
    "default_execution_mode": "compatibility_first",
    "allow_hard_delete": false,
    "allow_hot_path_physical_move": false,
    "require_compatibility_entrypoints_when_callers_exist": true,
    "preferred_reversible_action": "quarantine_or_trash"
  },
  "action_classes": [
    {
      "action": "preserve",
      "description": "Keep authoritative in place; no cleanup or relocation in the current phase."
    },
    {
      "action": "archive",
      "description": "Move only to an explicit archive/evidence location with continuity preserved."
    },
    {
      "action": "quarantine",
      "description": "Use a reversible trash/quarantine flow before any destructive cleanup."
    },
    {
      "action": "rotate",
      "description": "Permit bounded retention rotation without breaking the authoritative lookup surface."
    },
    {
      "action": "tool_only",
      "description": "Changes must go through an owning tool or package-manager style workflow, not ad hoc file moves."
    },
    {
      "action": "manual_review",
      "description": "No execution without explicit operator review because the surface mixes evidence, state, or caller risk."
    }
  ],
