  "operations_policy": {
    "global_rule_keys": [
      "default_execution_mode",
      "allow_hard_delete",
      "allow_hot_path_physical_move",
      "require_compatibility_entrypoints_when_callers_exist",
      "preferred_reversible_action"
    ],
