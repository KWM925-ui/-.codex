    "required_mode_classes": [
      "preserve_only",
      "reversible_only",
      "archive_only",
      "rotation_allowed",
      "tool_only",
      "manual_review_only"
    ],
    "required_selector_types": [
      "core_category",
      "runtime_category",
      "history_category",
      "namespace_type"
    ]
  },
  "migration_candidates": [
    {
      "id": "reference_mirrors_example_phase1",
      "selector_type": "namespace_type",
      "selector": "reference_bundle",
      "target": "project_assets/reference_mirrors",
      "candidate_kind": "compatibility_preserving_namespace_archive_candidate",
      "phase": "portable_phase1",
      "scope_root": "project_assets/reference_mirrors/reference_mirror_example",
      "compatibility_entrypoints": [
        "reference_mirror_example"
      ],
      "protected_paths": [
        "project_assets/reference_mirrors",
        "project_assets/reference_mirrors/reference_mirror_example",
        "reference_mirror_example"
      ],
      "preconditions": [
        "No physical move of the authoritative reference mirror tree in the current phase.",
        "The root compatibility entrypoint reference_mirror_example must continue to resolve to the namespace-owned example mirror tree.",
        "Namespace registry, manifest, and migration candidate contract must stay version-aligned before any future move candidate is promoted.",
        "Reference provenance and bundle identity must remain intact across any future archive handling."
      ],
      "planned_steps": [
        "Treat project_assets/reference_mirrors/reference_mirror_example as the example namespace anchor for reference mirror bundles.",
        "Preserve the root reference_mirror_example symlink unchanged as the required compatibility entrypoint for this sample contract.",
        "Keep reference subtrees namespaced under the reference_mirrors root; do not flatten per-repository mirrors into new top-level paths.",
        "If a later phase introduces deeper archive partitioning, update contracts and keep compatibility entrypoints resolving through a compatibility layer."
      ],
      "forbidden_actions": [
        "No destructive cleanup of mirrored reference repositories.",
        "No removal or repointing of the reference_mirror_example compatibility symlink in the current phase.",
        "No in-place rewriting of mirrored reference repositories only to normalize layout.",
        "No introduction of new root-level reference-mirror trees outside project_assets/reference_mirrors."
      ],
      "validation_commands": [
        "python3 core/control_plane/scripts/audit_codex_home_layout.py --root \"$CODEX_HOME\"",
        "python3 core/control_plane/scripts/review_archive_governed_targets.py --root \"$CODEX_HOME\""
      ]
    }
  ],
  "context_firewall_policy": {
    "required_stages": [
      "authority_filter",
      "trust_filter",
      "relevance_filter",
      "freshness_filter",
      "verbosity_filter"
    ],
    "required_source_classes": [
      "repo_state",
      "repo_instructions",
      "user_message",
      "operator_contract",
      "global_control",
      "tool_output",
      "session_memory",
      "retrieved_web",
      "untrusted_external"
    ],
    "allowed_treatments": [
      "authoritative_instruction",
      "evidence",
      "reference_only",
      "untrusted_data"
    ],
    "allowed_freshness_policies": [
      "stable",
      "session_local",
      "fresh_required",
      "stale_allowed",
      "freshness_scoped"
    ],
    "required_memory_kinds": [
      "stable_preference",
      "durable_workflow_rule",
      "project_fact",
      "volatile_task_state",
      "external_claim"
    ],
    "allowed_memory_actions": [
      "allow",
      "review_only",
      "deny"
    ],
    "forbidden_memory_kinds": [
      "external_claim"
    ],
    "required_profiles": [
      "strict",
      "balanced",
      "exploratory"
    ],
    "max_total_chars_upper_bound": 16000,
    "required_untrusted_source_classes": [
      "tool_output",
      "retrieved_web",
      "untrusted_external"
    ],
    "required_marker_categories": [
      "instruction_override",
      "credential_request",
      "tool_escalation",
      "exfiltration_request",
      "hidden_payload"
    ],
    "allowed_handling_actions": [
      "downgrade_to_data",
      "flag",
      "drop"
    ]
  },
  "project_namespaces": [
    {
      "id": "codex_home",
