      "core/control_plane/templates/project_task_pack/context_manifest.README.md"
    ],
    "project_task_root": ".codex/tasks",
    "project_session_root": ".codex/task_runtime/sessions",
    "required_artifacts": [
      "task.json",
      "prd.md",
      "design.md",
      "implement.md",
      "implement.jsonl",
      "check.jsonl",
      "research",
      "lessons.md"
    ],
    "required_statuses": [
      "planning",
      "in_progress",
      "completed",
      "archived"
    ],
    "required_commands": [
      "create",
      "start",
      "add-context",
      "validate",
      "complete",
      "archive",
      "status"
    ],
    "required_doc_phrases": [
      "Creating a task records planning state only",
      "Starting implementation is a separate step",
      "User consent to create a task does not imply user consent to start implementation",
      "stable context references only"
    ],
    "required_script_phrases": [
      "WORKFLOW_KIND = \"codex_project_task\"",
      "TASKS_DIR = \".codex/tasks\"",
      "SESSION_DIR = \".codex/task_runtime/sessions\"",
      "--confirm-plan-reviewed",
      "source-like file is not allowed in context manifests"
    ]
  },
  "project_namespaces": [
    {
      "id": "codex_home",
      "path": "project_assets/codex_home",
      "role": "self-productization ledgers and supervisor packs for ~/.codex",
      "required_paths": [
        "project_assets/codex_home/supervisor"
      ]
    },
    {
      "id": "sample_project",
      "path": "project_assets/sample_project",
      "role": "project overlay, case evidence, and frozen worktree evidence",
      "required_paths": [
        "project_assets/sample_project/supervisor",
        "project_assets/sample_project/control_plane_cases",
        "project_assets/sample_project/evidence"
      ]
    },
    {
      "id": "system_cleanup",
      "path": "project_assets/system_cleanup",
      "role": "system-space audit overlay and ledgers",
      "required_paths": [
        "project_assets/system_cleanup/supervisor"
      ]
    },
    {
      "id": "reference_mirrors",
      "path": "project_assets/reference_mirrors",
      "role": "reference source mirrors that are not reusable core assets",
      "required_paths": [
        "project_assets/reference_mirrors/upstream_audit"
      ]
    },
    {
      "id": "shared_imports",
      "path": "project_assets/shared_imports",
      "role": "shared imported bundles that are not reusable core assets",
      "required_paths": [
        "project_assets/shared_imports/vendor_imports"
      ]
    }
  ],
  "config_expectations": {
    "exact_trusted_projects": [
      "/home/example",
      "/home/example/.codex",
      "/home/example/codex_autoadvance_harness",
      "/home/example/example_ws",
